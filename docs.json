{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PARA Social Automation",
  "description": "LinkedIn and Reddit research, human review, and approved publishing.",
  "contextual": {
    "display": "header",
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "colors": {
    "primary": "#087F5B",
    "light": "#12B886",
    "dark": "#075B46"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Agent Contract",
        "icon": "bot",
        "groups": [
          {
            "group": "Required reading",
            "pages": [
              "agent"
            ]
          }
        ]
      },
      {
        "tab": "OpenAPI",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Reference",
            "openapi": {
              "source": "openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python"
      ]
    }
  },
  "footer": {
    "socials": {}
  }
}
