        "auto_activate_default": true,
        "activation_requires": [
          "ready_plan",
          "ten_unique_searches",
          "public_https_webhook"
        ],
        "author_enrichment": "first_pass_matches_only",
        "unknown_evidence": "neutral_score_reduced_coverage",
        "final_scoring": "deterministic_persisted_weights"
      }
    },
    "reddit": {
      "base_path": "/v1/reddit",
      "registration_path": "/v1/reddit/registrations",
      "agent_workflow": "https://para-linkedin-api.mintlify.app/agent.md#reddit",
      "event": "reddit.relevant_posts.daily.v1",
      "collection": "paired_real_chrome_extension",
      "author_context": "extension_only_public_profile",
      "result_access": [
        "webhook",
        "batch_polling",
        "post_detail_polling"
      ],
      "participation_actions": false
    }
  },
  "lifecycle": {
    "states": [
      "DRAFT",
      "ACTIVE",
      "PAUSED",
      "ARCHIVED"
    ],
    "collection_boundary": {
      "linkedin_legacy": "activate",
      "linkedin_compiler_native": "successful_compile_with_auto_activate_or_explicit_activate",
      "reddit": "activate"
    },
    "create_queues_work": {
      "linkedin_legacy": false,
      "linkedin_compiler_native": "compilation_and_conditional_ten-search_cycle",
      "reddit": false
    },
    "restore_target_state": "PAUSED",
    "archive_is_soft_delete": true
  },
  "webhooks": {
    "signature_algorithm": "HMAC-SHA256",
    "signature_input": "timestamp + '.' + raw_body",
    "signature_header": "X-Webhook-Signature",
    "timestamp_header": "X-Webhook-Timestamp",
    "event_id_header": "X-Webhook-Id",
    "success_status": "any_2xx",
    "empty_posts_is_success": true,
    "retry_delays": [
      "PT1M",
      "PT5M",
      "PT30M",
      "PT2H",
      "PT6H",
      "PT24H"
    ]
  },
  "agent_safety": {
    "read_only_without_extra_approval": [
      "health",
      "list",
      "get",
      "status",
      "batch_polling",
      "delivery_inspection"
    ],
    "requires_task_authorization": [
      "create",
      "patch",
      "activate",
      "pause",
      "restore",
      "run",
      "webhook_test"
    ],
    "requires_explicit_operator_approval": [
      "archive",
      "webhook_secret_rotation",
      "delivery_replay",
      "api_key_create",
      "api_key_rotation",
      "api_key_revocation"
    ],
    "unsupported": [
      "direct_platform_scraping",
      "synthetic_collection",
      "posting",
      "commenting",
      "voting",
      "automatic_draft_submission"
    ]
  }
